NEXT_PUBLIC_CURRENCY_SYMBOL="₹"

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full"

# Required in production (Vercel, Hostinger VPS, etc.)
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Public site URL — REQUIRED on Hostinger VPS (no trailing slash).
# Example: AUTH_URL="https://leafyland.com"
# Local dev:
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
ADMIN_EMAILS="admin@leafyland.com"

# Google OAuth (optional). Create at https://console.cloud.google.com/apis/credentials
# OAuth client → Web application
#
# Authorized JavaScript origins:
#   http://localhost:3000
#   https://yourdomain.com
#
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://yourdomain.com/api/auth/callback/google
#
# On Hostinger KVM2 VPS: set these in your .env on the server, then restart the app.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Image uploads — Hostinger VPS (persist across git pull / redeploy):
# UPLOAD_DIR="/var/www/leafyland/uploads"
# sudo mkdir -p /var/www/leafyland/uploads && sudo chown -R $USER:$USER /var/www/leafyland/uploads
#
# Optional Nginx (faster than Node for images):
# location /uploads/ {
#   alias /var/www/leafyland/uploads/;
#   expires 30d;
#   add_header Cache-Control "public, immutable";
#   access_log off;
# }

# Razorpay (Test Mode first — https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="your_test_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
#
# Webhook URL (Hostinger VPS):
#   https://yourdomain.com/api/razorpay/webhook
# Enable events: payment.captured, payment.failed
#
# Production: replace with live keys (rzp_live_...) and update webhook secret.
# RazorpayX Payouts (vendor settlements) — requires RazorpayX activation on the SAME keys.
# Until enabled, releases run in MANUAL mode: admin records the bank reference/UTR.
RAZORPAYX_ENABLED="false"
RAZORPAYX_ACCOUNT_NUMBER=""

# Email (Hostinger SMTP) — required for email/password signup verification
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@yourdomain.com"
SMTP_PASS="your_email_password"
EMAIL_FROM="LeafyLand <noreply@yourdomain.com>"
