generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String    @unique
    emailVerified DateTime?
    image         String    @default("")
    passwordHash  String?
    role          UserRole  @default(BUYER)
    cart          Json      @default("{}")
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    accounts        Account[]
    sessions        Session[]
    ratings         Rating[]
    Address         Address[]
    store           Store?
    buyerOrders     Order[]         @relation("BuyerRelation")
    checkoutBatches CheckoutBatch[]
    serviceBookings Booking[]       @relation("ServiceBookings")
    wishlist        WishlistItem[]
    serviceRatings  ServiceRating[]
    propertyRatings PropertyRating[]
    visits          Visit[]
    messages        Message[]
    notifications   Notification[]
}

model Account {
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String?
    access_token      String?
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String?
    session_state     String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([provider, providerAccountId])
}

model Session {
    sessionToken String   @id
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model VerificationToken {
    identifier String
    token      String
    expires    DateTime

    @@id([identifier, token])
}

// Required for creating a Product: name, description, mrp, price, images, category, storeId
model Product {
    id          String   @id @default(cuid())
    name        String
    description String
    mrp         Float
    price       Float
    images      String[]
    category    String
    inStock     Boolean  @default(true)
    stock       Int      @default(0)
    featured    Boolean  @default(false)
    status      String   @default("approved") // pending | approved | rejected
    storeId     String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    // Relations
    store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
    orderItems OrderItem[]
    rating     Rating[]

    @@index([status])
}

model Category {
    id        String   @id @default(cuid())
    name      String   @unique
    type      String   @default("leafy") // "leafy" | "marketplace"
    order     Int      @default(0)
    active    Boolean  @default(true)
    createdAt DateTime @default(now())

    @@index([type])
    @@index([active])
}

enum UserRole {
    BUYER
    ADMIN
}

enum OrderStatus {
    ORDER_PLACED
    PROCESSING
    SHIPPED
    DELIVERED
    CANCELLED
}

enum PaymentMethod {
    COD
    STRIPE
    BANK_TRANSFER
    UPI
    CARD
    WALLET
    RAZORPAY
}

enum PaymentStatus {
    PENDING
    AUTHORIZED
    CAPTURED
    FAILED
    REFUNDED
}

// Groups multi-store cart into one Razorpay payment
model CheckoutBatch {
    id                String        @id @default(cuid())
    userId            String
    addressId         String
    totalPaise        Int
    currency          String        @default("INR")
    paymentStatus     PaymentStatus @default(PENDING)
    paymentMethod     PaymentMethod @default(RAZORPAY)
    razorpayOrderId   String?       @unique
    razorpayPaymentId String?       @unique
    isCouponUsed      Boolean       @default(false)
    coupon            Json          @default("{}")
    stockFulfilled    Boolean       @default(false)
    createdAt         DateTime      @default(now())
    updatedAt         DateTime      @updatedAt
    capturedAt        DateTime?

    user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    address Address  @relation(fields: [addressId], references: [id])
    orders  Order[]
}

model RazorpayWebhookEvent {
    eventId     String   @id
    processedAt DateTime @default(now())
}

// Required for creating an Order: total, userId, storeId, addressId, isPaid, paymentMethod, isCouponUsed, coupon (JSON), orderItems (nested)
model Order {
    id              String        @id @default(cuid())
    total           Float
    status          OrderStatus   @default(ORDER_PLACED)
    userId          String
    storeId         String
    addressId       String?
    checkoutBatchId String?
    isPaid          Boolean       @default(false)
    paymentStatus   PaymentStatus @default(PENDING)
    paymentMethod   PaymentMethod
    createdAt       DateTime      @default(now())
    updatedAt       DateTime      @updatedAt
    isCouponUsed    Boolean       @default(false)
    coupon          Json          @default("{}")
    orderItems      OrderItem[]
    earning         Earning?

    // Relations
    user          User           @relation("BuyerRelation", fields: [userId], references: [id])
    store         Store          @relation(fields: [storeId], references: [id])
    address       Address?       @relation(fields: [addressId], references: [id], onDelete: SetNull)
    checkoutBatch CheckoutBatch? @relation(fields: [checkoutBatchId], references: [id], onDelete: SetNull)
}

// Required for creating an OrderItem: orderId, productId, quantity, price
model OrderItem {
    orderId   String
    productId String
    quantity  Int
    price     Float

    // Relations
    order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
    product Product @relation(fields: [productId], references: [id])

    @@id([orderId, productId])
}

// Required for creating a Rating: rating, review, userId, productId
model Rating {
    id        String   @id @default(cuid())
    rating    Int
    review    String
    userId    String
    productId String
    orderId   String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    @@unique([userId, productId, orderId])
}

// Required for creating an Address: userId, name, email, street, city, state, zip, country, phone
model Address {
    id        String   @id @default(cuid())
    userId    String
    name      String
    email     String
    street    String
    city      String
    state     String
    zip       String
    country   String
    phone     String
    label     String? // "Home" | "Work" | custom
    isDefault Boolean @default(false)
    latitude  Float?
    longitude Float?
    createdAt DateTime @default(now())

    // Relations
    Order Order[]
    user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    checkoutBatches CheckoutBatch[]
}

// Required for creating a Coupon: code, description, discount, forNewUser, isPublic, expiresAt
model Coupon {
    code        String   @id
    description String
    discount    Float
    forNewUser  Boolean
    forMember   Boolean  @default(false)
    isPublic    Boolean
    expiresAt   DateTime
    usageCount  Int      @default(0)
    storeId     String?
    createdAt   DateTime @default(now())

    store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// Required for creating a Store: userId, name, username, email, contact, logo, description, address (optional: , status, isActive)
model Store {
    id             String   @id @default(cuid())
    userId         String   @unique
    name           String
    description    String
    username       String   @unique
    address        String
    status         String   @default("pending")
    isActive       Boolean  @default(false)
    isVerified     Boolean  @default(false)
    commissionRate Float    @default(10)
    logo           String
    email          String
    contact        String
    settings       Json     @default("{}")
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    // Relations
    Product  Product[]
    Order    Order[]
    Property Property[]
    Service  Service[]
    Booking  Booking[]
    Coupon   Coupon[]
    Message  Message[]
    earnings Earning[]
    payouts  Payout[]
    user     User       @relation(fields: [userId], references: [id])
}

model Message {
    id        String   @id @default(cuid())
    storeId   String
    userId    String
    body      String
    reply     String?
    read      Boolean  @default(false)
    createdAt DateTime @default(now())

    store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ListingType {
    SALE
    RENT
}

// Property listing: farmhouses, land, farms, nurseries, gardens
model Property {
    id           String      @id @default(cuid())
    title        String
    description  String
    propertyType String // e.g. "Farmhouse", "Agricultural Land", "Nursery"
    listingType  ListingType @default(SALE)
    price        Float
    location     String
    landSize     String // free text e.g. "2 Kanal", "5 Acres"
    coveredArea  String?
    bedrooms     Int?
    bathrooms    Int?
    features     String[]    @default([]) // e.g. ["Water Availability", "Electricity", "Garden"]
    images       String[]
    latitude     Float?
    longitude    Float?
    status       String      @default("pending") // pending | approved | rejected
    storeId      String
    createdAt    DateTime    @default(now())
    updatedAt    DateTime    @updatedAt

    // Relations
    store  Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
    visits Visit[]
    rating PropertyRating[]
}

// Property visit request ("Schedule Visit" button)
model Visit {
    id         String   @id @default(cuid())
    propertyId String
    userId     String
    name       String
    phone      String
    date       DateTime
    time       String
    notes      String?
    status     String   @default("PENDING") // PENDING | CONFIRMED | COMPLETED | CANCELLED
    createdAt  DateTime @default(now())

    // Relations
    property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Service marketplace: landscaping, garden design, irrigation installation, etc.
model Service {
    id            String   @id @default(cuid())
    name          String
    description   String
    category      String // e.g. "Landscaping", "Irrigation", "Garden Maintenance"
    startingPrice Float
    duration      String? // display string, e.g. "2-3 hours"
    location      String
    images        String[]
    status        String   @default("pending")
    storeId       String
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    // Relations
    store    Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
    bookings Booking[]
    rating   ServiceRating[]
}

enum BookingStatus {
    PENDING
    CONFIRMED
    COMPLETED
    CANCELLED
}

// Service booking (parallel to Order, but for bookable services instead of purchasable products)
model Booking {
    id           String        @id @default(cuid())
    serviceId    String
    userId       String
    storeId      String
    price        Float
    date         DateTime
    time         String
    location     String
    requirements String?
    status       BookingStatus @default(PENDING)
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt

    // Relations
    service Service @relation(fields: [serviceId], references: [id])
    user    User    @relation("ServiceBookings", fields: [userId], references: [id])
    store   Store   @relation(fields: [storeId], references: [id])
}

// Rating for a Service, tied to a completed Booking (kept separate from Rating since
// Rating is hard-tied to productId + orderId and Services book through Booking, not Order)
model ServiceRating {
    id        String   @id @default(cuid())
    rating    Int
    review    String
    userId    String
    serviceId String
    bookingId String
    createdAt DateTime @default(now())

    // Relations
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

    @@unique([userId, serviceId, bookingId])
}

model PropertyRating {
    id         String   @id @default(cuid())
    rating     Int
    review     String
    userId     String
    propertyId String
    visitId    String
    createdAt  DateTime @default(now())

    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

    @@unique([userId, propertyId, visitId])
}

// Wishlist across all three marketplace verticals (Product / Property / Service).
// itemId is polymorphic — the actual Product/Property/Service row is resolved
// at the application layer based on itemType, since Prisma can't FK to multiple tables.
enum WishlistItemType {
    PRODUCT
    PROPERTY
    SERVICE
}

model WishlistItem {
    id        String           @id @default(cuid())
    userId    String
    itemId    String
    itemType  WishlistItemType
    createdAt DateTime         @default(now())

    // Relations
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, itemId, itemType])
}
model ContactInquiry {
    id        String   @id @default(cuid())
    name      String
    email     String
    subject   String
    message   String
    status    String   @default("NEW")
    createdAt DateTime @default(now())
}

// Vendor earning created when a checkout batch payment is captured.
// commissionRate is snapshotted so later Store.commissionRate edits never rewrite history.
model Earning {
    id              String    @id @default(cuid())
    orderId         String    @unique
    storeId         String
    grossPaise      Int
    commissionRate  Float
    commissionPaise Int
    status          String    @default("DUE") // DUE | PROCESSING | PAID
    eligibleAt      DateTime
    notifiedAt      DateTime?
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    order  Order   @relation(fields: [orderId], references: [id])
    store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
    payout Payout? @relation(fields: [payoutId], references: [id])
    payoutId String?
}

// One vendor settlement per admin release action.
model Payout {
    id                 String    @id @default(cuid())
    storeId            String
    status             String    @default("PROCESSING") // PROCESSING | PROCESSED | FAILED
    grossPaise         Int
    commissionPaise    Int
    commissionOverride Boolean   @default(false)
    netPaise           Int
    method             String    @default("RAZORPAYX") // RAZORPAYX | MANUAL
    razorpayPayoutId   String?   @unique
    fundAccountId      String?
    reference          String?
    failureReason      String?
    processedAt        DateTime?
    createdAt          DateTime  @default(now())
    updatedAt          DateTime  @updatedAt

    store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
    earnings Earning[]
}

model Notification {
    id        String    @id @default(cuid())
    userId    String
    type      String // PAYOUT_DUE | PAYOUT_RELEASED | PAYOUT_PAID | PAYOUT_FAILED
    title     String
    body      String
    link      String?
    readAt    DateTime?
    createdAt DateTime  @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
